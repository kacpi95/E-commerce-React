{
  "name": "react-course-routing",
  "private": true,
  "workspaces": [
    "front-end",
    "back-end"
  ],
  "dependencies": {
    "cp": "^0.2.0",
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "reset": "cp \"./back-end/backup/original_db.json\" ./back-end/db.json",
    "front-end": "npm run dev --workspace=front-end",
    "back-end": "npm run dev --workspace=back-end",
    "dev": "npm-run-all --parallel front-end back-end",
    "build": "npm run build --workspace=front-end && rm -rf back-end/public && mkdir -p back-end/public && cp -r front-end/dist/* back-end/public/",
    "start": "npm run start --workspace=back-end"
  }
}
